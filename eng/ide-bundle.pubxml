<Project>
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PackAsTool>false</PackAsTool>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- The CLI's saved-profile, protocol and RPC models intentionally use reflection.
         Preserve those assemblies in full; only framework/annotated dependencies are trimmed.
         A trim analyzer on these explicitly untrimmed models would describe an unsupported full
         trimming configuration. The linker still reports warnings as errors for the actual bundle. -->
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="$(MSBuildThisFileDirectory)ide-bundle.xml" />
  </ItemGroup>
</Project>
